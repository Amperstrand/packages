
config bitchat-relay 'bitchat-relay'
	# Enable the service (0 = disabled, 1 = enabled)
	option enabled '0'

	# Nickname advertised to other BitChat peers
	option nickname 'bitchat-relay'

	# Operating mode:
	#   listen   - receive-only observer, no identity, no sending
	#   chat     - full mesh participation (scan + subscribe, advertise + GATT, relay)
	#   announce - one-shot announce then exit
	option mode 'chat'

	# Use testnet service UUID (safe for testing, won't collide with real peers)
	option testnet '0'

	# BlueZ adapter path (empty = auto-detect first adapter)
	# Example: /org/bluez/hci0
	option adapter ''

	# Directory for persistent identity (Ed25519 + Curve25519 keys)
	option identity_dir '/etc/bitchat-relay'
